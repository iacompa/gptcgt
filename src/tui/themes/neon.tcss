/* Neon Theme — True black with cyberpunk neon accents */
/* Background */
Screen { background: #000000; }
.panel { background: #0A0A0A; }
.panel-active { background: #141414; }

/* Borders */
.border { border: solid #333333; }

/* Text */
.text-primary { color: #FFFFFF; }
.text-secondary { color: #A3A3A3; }
.text-code { color: #E5E5E5; }

/* Accents */
.accent { color: #06B6D4; }  /* Cyan */
.success { color: #A3E635; } /* Lime */
.warning { color: #FACC15; } /* Yellow */
.error { color: #F43F5E; }   /* Pink/Red */

/* Agent Colors */
.agent-claude { color: #D946EF; } /* Fuchsia */
.agent-gemini { color: #22D3EE; } /* Aqua */
.agent-gpt { color: #4ADE80; }    /* Bright Green */
.agent-grok { color: #F472B6; }   /* Pink */
.agent-deepseek { color: #F97316; } /* Bright Orange */

/* Diff Colors */
.diff-added { background: #14532D; color: #A3E635; }
.diff-removed { background: #881337; color: #F43F5E; }
.diff-context { color: #A3A3A3; }

/* Layout */
#app-grid { layout: horizontal; height: 100%; }
#left-panel-container { width: 1fr; min-width: 20; }
#code-viewer { width: 2fr; min-width: 30; }
#right-panel { width: 1fr; min-width: 25; }

/* Status Bar */
#status-bar { dock: bottom; height: 1; background: #0A0A0A; color: #FFFFFF; border-top: solid #06B6D4; }

/* Activity Feed */
.activity-entry { padding: 0 1; }
.activity-timestamp { color: #A3A3A3; }
.activity-orchestrator { color: #06B6D4; }
.activity-header { background: #141414; padding: 1; text-style: bold; }
.active-agent-chip { padding: 0 1; }


/* --- Canvas Mode: Select-to-Prompt & Context Chips --- */
CodeView, #code-lines-scroll, CodeViewerPanel {
    background: #000000;
}

CodeLineWidget {
    width: auto;
    min-width: 100%;
    height: 1;
    background: transparent;
}

.code-line:hover {
    background: #141414;
}

.code-line-selected {
    background: #0E3A4A;
    color: #FFFFFF;
}

.selection-mode-indicator {
    background: #A3E635;
    color: #000000;
    text-align: center;
    border-bottom: solid #333333;
    height: 1;
    content-align: center middle;
}

ContextChipBar {
    background: #000000;
    border-bottom: solid #333333;
    padding: 0 1;
    height: 3;
}

ContextChip {
    background: #141414;
    border: blank;
    color: #FFFFFF;
    margin: 0 1 0 0;
    padding: 0 1;
}

ContextChip:hover {
    background: #0E3A4A;
}

.chip-remove {
    color: #F43F5E;
    margin-left: 1;
}

.chip-remove:hover {
    color: #FB7185;
    text-style: bold;
}

AddFileChip {
    color: #06B6D4;
    border: blank;
    background: transparent;
    height: 1;
    width: auto;
    padding: 0 1;
}

AddFileChip:hover {
    background: #141414;
}

/* --- Canvas Mode: Collapsible Code Blocks --- */
.collapsible-code-content {
    background: #000000;
    border: solid #333333;
    padding: 1;
    margin: 0 0 1 0;
    overflow-y: auto;
    max-height: 20;
}

Collapsible {
    border: solid #333333;
    background: #0A0A0A;
    margin: 0 0 1 0;
}

CollapsibleTitle > Label {
    color: #E5E5E5;
}

/* --- Canvas Mode: Quick Actions Bar --- */
QuickActionsBar {
    background: #0A0A0A;
    border-top: solid #333333;
    height: 3;
    padding: 0 1;
}

QuickActionButton {
    background: #A3E635;
    color: #000000;
    margin-right: 1;
}

QuickActionButton:hover {
    background: #D9F99D;
}

.qa-label {
    color: #A3A3A3;
    margin-right: 2;
}


/* ══════════════════════════════════════════════════════════════
   Phase 6 — Interactive Canvas Mode (Part 2)
   ══════════════════════════════════════════════════════════════ */

/* Hunk Editor */
.hunk-editor-container {
    border: dashed #06B6D4;
    background: #141414;
    margin: 1 0;
    padding: 0;
}
.hunk-editor-header {
    background: #0A0A0A;
    color: #FACC15;
    text-style: bold;
    padding: 0 1;
    height: 1;
}
.hunk-editor-textarea {
    min-height: 5;
    height: auto;
    max-height: 25;
    background: #000000;
    border: solid #333333;
}
.hunk-editor-controls {
    height: 3;
    align: center middle;
    padding: 0 1;
    background: #0A0A0A;
}
.hunk-editor-controls Button {
    margin: 0 1;
}
.hunk-user-edited {
    border-left: heavy #06B6D4;
}

/* Annotations */
.annotation-gutter {
    width: 2;
    text-align: center;
    padding: 0;
}
.annotation-gutter-error { color: #F43F5E; }
.annotation-gutter-warning { color: #FACC15; }
.annotation-gutter-info { color: #06B6D4; }
.annotation-gutter-suggestion { color: #22D3EE; }
.annotation-panel {
    background: #0A0A0A;
    border: solid #333333;
    padding: 1 2;
    margin: 0 0 0 4;
    height: auto;
}
.annotation-panel-error { border-left: heavy #F43F5E; }
.annotation-panel-warning { border-left: heavy #FACC15; }
.annotation-panel-info { border-left: heavy #06B6D4; }
.annotation-panel-suggestion { border-left: heavy #22D3EE; }
.annotation-panel-header { text-style: bold; margin-bottom: 1; }
.annotation-panel-detail { color: #E5E5E5; margin-bottom: 1; }
.annotation-panel-actions { height: 3; }
.annotation-action-button { margin: 0 1; }

/* Arbiter Verdict Panel */
.arbiter-panel {
    border: double #06B6D4;
    background: #0A0A0A;
    padding: 1 2;
    margin: 1 0;
}
.arbiter-panel-header { text-style: bold; color: #FFFFFF; margin-bottom: 1; }
.arbiter-panel-summary { color: #A3A3A3; margin-bottom: 1; }
.arbiter-panel-spacer { height: 1; }
.arbiter-agent-header { color: #06B6D4; text-style: bold; margin-bottom: 1; }
.arbiter-score-row {
    padding: 0 1;
    height: auto;
}
.arbiter-score-pass { color: #A3E635; }
.arbiter-score-warn { color: #FACC15; }
.arbiter-score-fail { color: #F43F5E; }
.arbiter-detail-expanded {
    background: #000000;
    padding: 1 2;
    margin: 0 0 1 2;
    border-left: solid #333333;
}
.arbiter-total-row { text-style: bold; margin-top: 1; }
.arbiter-winner-row {
    border: solid #A3E635;
    background: #0A1A00;
    padding: 0 1;
}
.arbiter-eliminated-row { color: #A3A3A3; }
.arbiter-evidence-header { color: #06B6D4; text-style: bold; }
.arbiter-evidence-item { color: #E5E5E5; }
.arbiter-action-buttons { height: 3; margin-top: 1; }
.arbiter-diff-button { margin: 0 1; }
.arbiter-cherry-pick-button { margin: 0 1; }
.arbiter-timing { color: #737373; margin-top: 1; }
.arbiter-confidence-badge { text-style: bold; }

