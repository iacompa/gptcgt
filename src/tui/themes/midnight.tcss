/* Midnight Theme — Default Dark */

/* Background */
Screen { 
    background: $background;
    scrollbar-size: 1 1;
    overflow: hidden;
}
.panel { background: $panel; }
.panel-active { background: $surface; }

/* Borders */
.border { border: solid $secondary; }

/* Text */
.text-primary { color: $text; }
.text-secondary { color: $text-muted; }
.text-code { color: $text; }

/* Accents */
.accent { color: $primary; }
.success { color: $success; }
.warning { color: $warning; }
.error { color: $error; }

/* Agent Colors */
.agent-claude { color: #A78BFA; }
.agent-gemini { color: #60A5FA; }
.agent-gpt { color: #34D399; }
.agent-grok { color: #F472B6; }
.agent-deepseek { color: #FB923C; }

/* Diff Colors */
.diff-added { background: $success 15%; color: $success; }
.diff-removed { background: $error 15%; color: $error; }
.diff-context { color: $text-muted; }

/* Layout */
#app-grid { layout: horizontal; height: 1fr; }
#left-panel-container { min-width: 15; }
#code-viewer { min-width: 15; }
#right-panel { min-width: 15; }

/* Status Bar */
#status-bar { dock: bottom; height: 1; background: $panel; color: $text; }

/* Activity Feed */
.activity-entry { padding: 0 1; }
.activity-timestamp { color: $text-muted; }
.activity-orchestrator { color: $primary; }
.activity-header { background: $surface; padding: 1; text-style: bold; }
.active-agent-chip { padding: 0 1; }


/* --- Canvas Mode: Select-to-Prompt & Context Chips --- */
CodeView, #code-lines-scroll, CodeViewerPanel {
    background: $background;
}

CodeLineWidget {
    width: auto;
    min-width: 100%;
    height: 1;
    background: transparent;
}

.code-line:hover {
    background: $surface;
}

.code-line-selected {
    background: $primary 20%;
    color: white;
}

.selection-mode-indicator {
    background: $primary 30%;
    color: $text;
    text-align: center;
    border-bottom: solid $primary;
    height: 1;
    content-align: center middle;
}

ContextChipBar {
    background: $background;
    border-bottom: solid $secondary;
    padding: 0 1;
}

ContextChip {
    background: $surface;
    border: blank;
    color: $text;
    margin: 0 1 0 0;
    padding: 0 1;
}

ContextChip:hover {
    background: $primary 20%;
}

.chip-remove {
    color: $error;
    margin-left: 1;
}

.chip-remove:hover {
    text-style: bold;
    color: #FF7B72;
}

/* Scrollbar styling */


/* --- Canvas Mode: Collapsible Code --- */
CollapsibleCodeBlock {
    margin: 1 0;
    width: 100%;
}

.collapsible-code-content {
    background: $background;
    border: solid $secondary;
    padding: 1 2;
    border-top: none;
}

CollapsibleTitle > Label {
    text-style: bold;
    color: $text;
}

Collapsible {
    border: solid $secondary;
    background: $panel;
}

/* --- Canvas Mode: Quick Actions Bar --- */
QuickActionsBar {
    background: $panel;
    border-top: solid $secondary;
    height: 3;
    align: left middle;
    padding: 0 1;
}

QuickActionButton {
    border: none;
    background: $success;
    color: $text;
    height: 1;
    min-width: 10;
    margin-right: 1;
}

QuickActionButton:hover {
    background: $success 80%;
}

.qa-label {
    color: $text-muted;
    text-style: bold;
    margin-right: 2;
}


/* ══════════════════════════════════════════════════════════════
   Phase 6 — Interactive Canvas Mode (Part 2)
   ══════════════════════════════════════════════════════════════ */

/* Hunk Editor */
.hunk-editor-container {
    border: dashed $primary;
    background: $surface;
    margin: 1 0;
    padding: 0;
}
.hunk-editor-header {
    background: $panel;
    color: $warning;
    text-style: bold;
    padding: 0 1;
    height: 1;
}
.hunk-editor-textarea {
    min-height: 5;
    height: auto;
    max-height: 25;
    background: $background;
    border: solid $secondary;
}
.hunk-editor-controls {
    height: 3;
    align: center middle;
    padding: 0 1;
    background: $panel;
}
.hunk-editor-controls Button {
    margin: 0 1;
}
.hunk-user-edited {
    border-left: heavy $primary;
}

/* Annotations */
.annotation-gutter {
    width: 2;
    text-align: center;
    padding: 0;
}
.annotation-gutter-error { color: $error; }
.annotation-gutter-warning { color: $warning; }
.annotation-gutter-info { color: $primary; }
.annotation-gutter-suggestion { color: $accent; }
.annotation-panel {
    background: $panel;
    border: solid $secondary;
    padding: 1 2;
    margin: 0 0 0 4;
    height: auto;
}
.annotation-panel-error { border-left: heavy $error; }
.annotation-panel-warning { border-left: heavy $warning; }
.annotation-panel-info { border-left: heavy $primary; }
.annotation-panel-suggestion { border-left: heavy $accent; }
.annotation-panel-header { text-style: bold; margin-bottom: 1; }
.annotation-panel-detail { color: $text; margin-bottom: 1; }
.annotation-panel-actions { height: 3; }
.annotation-action-button { margin: 0 1; }

/* Arbiter Verdict Panel */
.arbiter-panel {
    border: double $primary;
    background: $panel;
    padding: 1 2;
    margin: 1 0;
}
.arbiter-panel-header { text-style: bold; color: $text; margin-bottom: 1; }
.arbiter-panel-summary { color: $text-muted; margin-bottom: 1; }
.arbiter-panel-spacer { height: 1; }
.arbiter-agent-header { color: $primary; text-style: bold; margin-bottom: 1; }
.arbiter-score-row {
    padding: 0 1;
    height: auto;
}
.arbiter-score-pass { color: $success; }
.arbiter-score-warn { color: $warning; }
.arbiter-score-fail { color: $error; }
.arbiter-detail-expanded {
    background: $background;
    padding: 1 2;
    margin: 0 0 1 2;
    border-left: solid $secondary;
}
.arbiter-total-row { text-style: bold; margin-top: 1; }
.arbiter-winner-row {
    border: solid $success;
    background: #0D2818;
    padding: 0 1;
}
.arbiter-eliminated-row { color: $text-muted; }
.arbiter-evidence-header { color: $primary; text-style: bold; }
.arbiter-evidence-item { color: $text; }
.arbiter-action-buttons { height: 3; margin-top: 1; }
.arbiter-diff-button { margin: 0 1; }
.arbiter-cherry-pick-button { margin: 0 1; }
.arbiter-timing { color: #484F58; margin-top: 1; }
.arbiter-confidence-badge { text-style: bold; }
